{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "regions": ["bom1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=900, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "_comment": "The previous product's public URLs. The destination carries the BODY because a constituency name does not identify a seat: /constituency/<slug> is now the legacy numeric-id route and 404s on a name. The old site held West Bengal ASSEMBLY seats only, which is why the body is known here.",
      "source": "/west-bengal/:slug",
      "destination": "/constituency/wb/assembly/:slug"
    }
  ],
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://wbvotes.in"
  }
}
