{
  "name": "wb-votes",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "mandate": "node packages/mandate/bin/mandate.ts",
    "test": "node --test \"packages/mandate/src/**/*.test.ts\"",
    "registry:migrate": "node packages/mandate/bin/mandate.ts migrate",
    "registry:ingest": "node packages/mandate/bin/mandate.ts ingest",
    "registry:resolve": "node packages/mandate/bin/mandate.ts resolve",
    "registry:audit": "node packages/mandate/bin/mandate.ts audit",
    "registry:typecheck": "tsc --noEmit -p packages/mandate/tsconfig.json 2>&1 | grep \"error TS\" | grep \"^packages/mandate\" && exit 1 || echo \"typecheck clean (packages/mandate)\"",
    "geo:coverage": "node packages/mandate/bin/mandate.ts geography coverage --write",
    "geo:inspect": "node packages/mandate/bin/mandate.ts geography inspect --write",
    "release:report": "node packages/mandate/bin/mandate.ts release --write"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "typescript": "^5"
  }
}
