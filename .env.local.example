# Nothing in src/ needs a .env.local to run. Every variable the code reads is listed here, all optional.
# (The Supabase, Google Maps and election-phase variables this file used to list belong to a product that no longer exists.)

# Where the registry (a SQLite file) is. Default: .data/registry.db. In production: /data/registry.db (fly.toml).
# MANDATE_DB_PATH=.data/registry.db

# Build output directory. Use another one when a dev server is up, or the two fight over .next.
# MANDATE_DIST=.next-verify

# Lets /review/merges record merge decisions. LOCAL ONLY: the app has no auth, and production must never set it.
# MANDATE_REVIEW_WRITES=1

# A live-results file the front page and /v1/live read. Nothing in this repository produces it; unset means no live board.
# MANDATE_LIVE_PATH=

# Verbose ingest transport logging.
# MANDATE_VERBOSE=1
