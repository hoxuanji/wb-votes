# Environment Variables

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="WB Votes"

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# Optional: Analytics (privacy-respecting)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yoursite.com

# Election cycle phase: pre | live | post | governance
#   pre        — campaign mode (candidates explorer)
#   live       — counting day (live tally; needs ECI scraper running)
#   post       — just-finished-counting (Story-So-Far, ~2 weeks)
#   governance — steady-state between elections (cabinet, MLAs, projects)
NEXT_PUBLIC_ELECTION_PHASE=governance

# Google Maps — required for GovernanceGeoMap (geotagging, project pins, issue location)
# Enable: Maps JS API · Geocoding API · Places API at console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here
